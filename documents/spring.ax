# spring.ax — Damped harmonic oscillator
\import "lib/exp.ax"
\import "lib/trig.ax"

m = 1.0
k = 4.0
c = 0.2
# Natural frequency omega0 = sqrt(k/m) = 2.0
# Damping ratio gamma = c / (2m) = 0.1
# Damped frequency omega_d = sqrt(omega0^2 - gamma^2) = sqrt(4 - 0.01) = 1.9974984
# x(t) = x0 * exp(-gamma * t) * cos(omega_d * t)
:x0 = 3.0
:gamma = 0.1
:omega_d = 1.9974984

# Differential equations of motion
d//d:time :x = :vx
d//d:time :vx = -(k / m) * :x - (c / m) * :vx

# Position oscillation curve over time
{\axis :time, :x; :x = :x0 * :exp(-:gamma * :time) * :cos(:omega_d * :time)}

# Position at t = 3.0s
:x_3 = :x0 * :exp(-:gamma * 3.0) * :cos(:omega_d * 3.0)
