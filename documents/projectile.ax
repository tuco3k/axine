# projectile.ax — Projectile motion with gravity and air drag
\import "lib/exp.ax"

m = 1.0
g = 9.8
c = 0.05
:vx0 = 10.0
:vy0 = 15.0

# Differential equations of motion with linear drag
d//d:time :vx = -(c / m) * :vx
d//d:time :vy = -g - (c / m) * :vy

# Exact closed-form velocity and position relations:
# vx(t) = vx0 * exp(-c*t/m)
# vy(t) = (vy0 + m*g/c)*exp(-c*t/m) - m*g/c
# y(t) = (vy0 + m*g/c)*(m/c)*(1 - exp(-c*t/m)) - (m*g/c)*t
{\axis :time, :y; :y = (:vy0 + m * g / c) * (m / c) * (1 - :exp(-c * :time / m)) - (m * g / c) * :time}

# Sample kinetic energy at t = 1.0s
:vx_1 = :vx0 * :exp(-c * 1.0 / m)
:vy_1 = (:vy0 + m * g / c) * :exp(-c * 1.0 / m) - m * g / c
:E_k1 = 0.5 * m * (:vx_1^2 + :vy_1^2)
