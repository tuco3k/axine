# orbit.ax — Planetary orbit under inverse-square gravitational force
\import "lib/sqrt.ax"
\import "lib/trig.ax"

:GM = 100.0
:r0 = 10.0
# Circular orbital speed: v0 = sqrt(GM/r0) = sqrt(10) = 3.16227766
:v0 = 3.16227766
# Orbital angular frequency: omega = v0 / r0 = 0.316227766 rad/s
:omega = :v0 / :r0

# Central force equations of motion:
# d//d:time :vx = -GM * x / (x^2 + y^2)^(3/2)
# d//d:time :vy = -GM * y / (x^2 + y^2)^(3/2)
d//d:time :x = :vx
d//d:time :y = :vy

# Spatial orbital trajectory in position space
{\axis x, y; x^2 + y^2 = :r0^2}

# Angular momentum conservation relation: L = x * vy - y * vx
# In circular orbit, L = r0 * v0 = 10.0 * 3.16227766 = 31.6227766
:L_10 = :r0 * :v0
