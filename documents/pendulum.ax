# pendulum.ax — Simple pendulum trajectory and energy
\import "lib/trig.ax"

L = 2.0
g = 9.81
:theta0 = 0.5

# Nonlinear pendulum differential relations:
# d//d:time :theta = :omega
# d//d:time :omega = -(g / L) * :sin(:theta)
d//d:time :theta = :omega
d//d:time :omega = -(g / L) * :sin(:theta)

# Small-angle harmonic approximation: omega0 = sqrt(g/L) ~= 2.214723
# theta(t) = theta0 * cos(sqrt(g/L) * t)
{\axis :time, :theta; :theta = :theta0 * :cos(2.214723 * :time)}

# Mechanical energy conservation relation: E = 1/2 m L^2 omega^2 + m g L (1 - cos(theta))
{\axis :theta, :omega; 0.5 * L^2 * :omega^2 + g * L * (1 - :cos(:theta)) = g * L * (1 - :cos(:theta0))}

# State at t = 2.0s
:theta_2 = :theta0 * :cos(2.214723 * 2.0)
:omega_2 = -:theta0 * 2.214723 * :sin(2.214723 * 2.0)
:s_2 = (:theta_2, :omega_2)
