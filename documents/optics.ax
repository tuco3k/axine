# optics.ax — Geometric optics and Snell's Law in pure Axine
\import "lib/sqrt.ax"

:Ray = \record { :origin, :direction, :intensity }

# Air medium (n1 = 1.0) for x in [0, 5], Glass medium (n2 = 1.5) for x in [5, 10]
:n1 = 1.0
:n2 = 1.5

# Initial ray incident at 45 degrees
:r0 = :Ray(:origin: (0.0, 0.0), :direction: (0.707106, 0.707106), :intensity: 1.0)

# Ray state after refraction through boundary at x = 5.0
:r_end = :Ray(:origin: (10.0, 7.6726), :direction: (0.8819, 0.4714), :intensity: 1.0)

# Incident ray trajectory at 45 degrees: y = x for x <= 5
# Refracted ray at boundary (5, 5): y = 5 + m2*(x - 5) for x > 5
{\axis x, y;
  y = \if x <= 5.0 \then x \else 5.0 + 0.53452248 * (x - 5.0) \where x \in [0, 10]
}

