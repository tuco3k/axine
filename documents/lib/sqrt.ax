# sqrt.ax — Square root defined as mathematical relation with Newton search
\module :sqrt
\import "newton.ax"

\forall a, b, :idiv(a, b) = (a - (a % b)) / b

\forall x, y, :int_sqrt_step(x, y) = \if :idiv(y + :idiv(x, y), 2) >= y \then y \else :int_sqrt_step(x, :idiv(y + :idiv(x, y), 2))
\forall x, :int_sqrt(x) = \if x < 0 \then -1 \else (\if x <= 1 \then x \else :int_sqrt_step(x, :idiv(x, 2)))

\forall x, :is_perfect_square(x) = \if (:int_sqrt(x) * :int_sqrt(x)) = x \then :int_sqrt(x) \else -1

# \forall x, :sqrt(x) = y \where y^2 = x \and y >= 0
# If x < 0: stands unreduced in R.
# If x is a perfect square: returns exact integer root.
# Otherwise: evaluates Newton recurrence.
\forall x, :sqrt(x) = \if x < 0 \then (:sqrt(x)) \else (\if (x % 1 = 0) \and (:is_perfect_square(x) >= 0) \then :is_perfect_square(x) \else :newton_sqrt(x))

\export :sqrt, :int_sqrt, :int_sqrt_step, :is_perfect_square, :idiv
