# sqrt.ax — Square root defined as mathematical relation with Newton search
\module :sqrt
\import "newton.ax"

# Exact recognizer rule for standard small perfect squares
\forall x, :is_perfect_square(x) = \if x = 0 \then 0 \else (\if x = 1 \then 1 \else (\if x = 4 \then 2 \else (\if x = 9 \then 3 \else (\if x = 16 \then 4 \else (\if x = 25 \then 5 \else (\if x = 36 \then 6 \else (\if x = 49 \then 7 \else (\if x = 64 \then 8 \else (\if x = 81 \then 9 \else (\if x = 100 \then 10 \else -1))))))))))

# \forall x, :sqrt(x) = y \where y^2 = x \and y >= 0
# If x < 0: stands unreduced in R.
# If x is a perfect square: returns exact integer root.
# Otherwise: evaluates Newton recurrence.
\forall x, :sqrt(x) = \if x < 0 \then (:sqrt(x)) \else (\if :is_perfect_square(x) >= 0 \then :is_perfect_square(x) \else :newton_sqrt(x))

\export :sqrt
