# newton.ax — Newton-Raphson root search method in pure Axine
\module :newton

\forall x, y, :newton_sqrt_step(x, y) = 0.5 * (y + x / y)

\forall x, :newton_sqrt_core(x) = {
  :y0 = 0.5 * (x + 1);
  :y1 = 0.5 * (:y0 + x / :y0);
  :y2 = 0.5 * (:y1 + x / :y1);
  :y3 = 0.5 * (:y2 + x / :y2);
  :y4 = 0.5 * (:y3 + x / :y3);
  :y5 = 0.5 * (:y4 + x / :y4);
  0.5 * (:y5 + x / :y5)
}

\forall x, :newton_sqrt(x) = \if x <= 0 \then 0 \else (\if x >= 0.25 \and x <= 4.0 \then :newton_sqrt_core(x) \else (\if x > 4.0 \then (\if x <= 16.0 \then 2 * :newton_sqrt_core(x / 4) \else (\if x <= 256.0 \then 4 * :newton_sqrt_core(x / 16) \else (\if x <= 65536.0 \then 16 * :newton_sqrt_core(x / 256) \else 256 * :newton_sqrt_core(x / 65536)))) \else (\if x < 0.00390625 \then (1 / 256) * :newton_sqrt_core(x * 65536) \else (\if x < 0.0625 \then (1 / 16) * :newton_sqrt_core(x * 256) \else 0.5 * :newton_sqrt_core(x * 4)))))

\export :newton_sqrt_step, :newton_sqrt_core, :newton_sqrt
