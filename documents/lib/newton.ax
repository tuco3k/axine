# newton.ax — Newton-Raphson root search method in pure Axine
\module :newton

# Step recurrence for finding root of f(y) = y^2 - x = 0:
# y_{n+1} = 0.5 * (y_n + x / y_n)
# Precision: 6 steps starting from y0 = (x + 1) / 2 provides quadratic convergence 
# to ~50 decimal places (error < 1e-15), which exceeds float64 precision.
\forall x, y, :newton_sqrt_step(x, y) = 0.5 * (y + x / y)

\forall x, :newton_sqrt(x) = {
  :y0 = \if x > 1 \then (x + 1) / 2 \else 1.0;
  :y1 = 0.5 * (:y0 + x / :y0);
  :y2 = 0.5 * (:y1 + x / :y1);
  :y3 = 0.5 * (:y2 + x / :y2);
  :y4 = 0.5 * (:y3 + x / :y3);
  :y5 = 0.5 * (:y4 + x / :y4);
  0.5 * (:y5 + x / :y5)
}

\export :newton_sqrt_step, :newton_sqrt
