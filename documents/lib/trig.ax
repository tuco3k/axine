\import "sqrt.ax"

# Precision: 13 Taylor polynomial terms (degree 25) for sin and cos
\forall x, :sin_series(x) = x - (x^3)/6 + (x^5)/120 - (x^7)/5040 + (x^9)/362880 - (x^11)/39916800 + (x^13)/6227020800 - (x^15)/1307674368000 + (x^17)/355687428096000 - (x^19)/121645100408832000 + (x^21)/51090942171709440000 - (x^23)/25852016738884976640000 + (x^25)/15511210043330985984000000

\forall x, :cos_series(x) = 1 - (x^2)/2 + (x^4)/24 - (x^6)/720 + (x^8)/40320 - (x^10)/3628800 + (x^12)/479001600 - (x^14)/87178291200 + (x^16)/20922789888000 - (x^18)/6402373705728000 + (x^20)/2432902008176640000 - (x^22)/1124000727777607680000 + (x^24)/620448401733239439360000

\forall x, :reduce_angle(x) = (((x + 3.141592653589793) % 6.283185307179586 + 6.283185307179586) % 6.283185307179586) - 3.141592653589793

\forall x, :sin(x) = \if x = 0 \then 0 \else (\if :reduce_angle(x) > 1.5707963267948966 \then :sin_series(3.141592653589793 - :reduce_angle(x)) \else (\if :reduce_angle(x) < -1.5707963267948966 \then (-:sin_series(3.141592653589793 + :reduce_angle(x))) \else :sin_series(:reduce_angle(x))))

\forall x, :cos(x) = \if x = 0 \then 1 \else (\if :reduce_angle(x) > 1.5707963267948966 \then (-:cos_series(3.141592653589793 - :reduce_angle(x))) \else (\if :reduce_angle(x) < -1.5707963267948966 \then (-:cos_series(3.141592653589793 + :reduce_angle(x))) \else :cos_series(:reduce_angle(x))))

\forall x, :tan(x) = \if x = 0 \then 0 \else (:sin(x) / :cos(x))

# Inverse trigonometric functions
\forall x, :asin_series(x) = x + (x^3)/6 + (3 * x^5)/40 + (5 * x^7)/112 + (35 * x^9)/1152 + (63 * x^11)/2816 + (231 * x^13)/13312 + (143 * x^15)/10240 + (6435 * x^17)/557056 + (12155 * x^19)/1245184 + (46189 * x^21)/5505024 + (96577 * x^23)/12058624 + (1300075 * x^25)/170393600
\forall x, :asin(x) = \if x = 0 \then 0 \else :asin_series(x)
\forall x, :acos(x) = 1.5707963267948966 - :asin(x)
\forall x, :atan_series(x) = x - (x^3)/3 + (x^5)/5 - (x^7)/7 + (x^9)/9 - (x^11)/11 + (x^13)/13 - (x^15)/15
\forall x, :atan_half(x) = x / (1 + :sqrt(1 + x^2))
\forall x, :atan(x) = \if x = 0 \then 0 \else (\if x > 0.5 \or x < -0.5 \then (4 * :atan_series(:atan_half(:atan_half(x)))) \else :atan_series(x))

# Hyperbolic functions
\forall x, :sinh_series(x) = x + (x^3)/6 + (x^5)/120 + (x^7)/5040 + (x^9)/362880 + (x^11)/39916800 + (x^13)/6227020800
\forall x, :cosh_series(x) = 1 + (x^2)/2 + (x^4)/24 + (x^6)/720 + (x^8)/40320 + (x^10)/3628800 + (x^12)/479001600
\forall x, :sinh(x) = \if x = 0 \then 0 \else :sinh_series(x)
\forall x, :cosh(x) = \if x = 0 \then 1 \else :cosh_series(x)
\forall x, :tanh(x) = :sinh(x) / :cosh(x)

\export :sin, :cos, :tan, :asin, :acos, :atan, :sinh, :cosh, :tanh, :sin_series, :cos_series, :reduce_angle, :atan_half
