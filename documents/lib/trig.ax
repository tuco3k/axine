# trig.ax — Trigonometric functions defined via Taylor series relations
\module :trig

# Precision: 8 Taylor polynomial terms (degree 17) for sin and cos
# For |x| <= pi, remainder |R_8(x)| <= pi^19 / 19! < 5.8e-18, guaranteeing full float64 precision.
# :sin(0) = 0 and :cos(0) = 1 evaluate exactly.

\forall x, :sin_series(x) = x - (x^3)/6 + (x^5)/120 - (x^7)/5040 + (x^9)/362880 - (x^11)/39916800 + (x^13)/6227020800 - (x^15)/1307674368000 + (x^17)/355687428096000

\forall x, :cos_series(x) = 1 - (x^2)/2 + (x^4)/24 - (x^6)/720 + (x^8)/40320 - (x^10)/3628800 + (x^12)/479001600 - (x^14)/87178291200 + (x^16)/20922789888000

\forall x, :sin(x) = \if x = 0 \then 0 \else :sin_series(x)
\forall x, :cos(x) = \if x = 0 \then 1 \else :cos_series(x)
\forall x, :tan(x) = :sin(x) / :cos(x)

\export :sin, :cos, :tan, :sin_series, :cos_series
