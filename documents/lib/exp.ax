# exp.ax — Exponential and logarithm functions defined via Taylor series and inverse search
\module :exp

# Precision: 12 Taylor polynomial terms for exp.
# For |x| <= 1, remainder |R_12(x)| <= 1 / 13! < 1.6e-10.
\forall x, :exp(x) = 1 + x + (x^2)/2 + (x^3)/6 + (x^4)/24 + (x^5)/120 + (x^6)/720 + (x^7)/5040 + (x^8)/40320 + (x^9)/362880 + (x^10)/3628800 + (x^11)/39916800 + (x^12)/479001600

# Natural log for x near 1 via series: u = x - 1
\forall x, :ln_series(u) = u - (u^2)/2 + (u^3)/3 - (u^4)/4 + (u^5)/5 - (u^6)/6 + (u^7)/7 - (u^8)/8

\forall x, :ln(x) = \if x <= 0 \then (:ln(x)) \else (\if x = 1 \then 0 \else :ln_series(x - 1))

\export :exp, :ln
