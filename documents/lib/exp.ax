# exp.ax — Exponential and logarithm functions defined via Taylor series and inverse search
\module :exp

\import "sqrt.ax"

# Precision: 12 Taylor polynomial terms for exp.
\forall x, :exp_series(x) = 1 + x + (x^2)/2 + (x^3)/6 + (x^4)/24 + (x^5)/120 + (x^6)/720 + (x^7)/5040 + (x^8)/40320 + (x^9)/362880 + (x^10)/3628800 + (x^11)/39916800 + (x^12)/479001600

\forall x, :exp_pos(x) = \if x <= 1.0 \then :exp_series(x) \else (\if x <= 4.0 \then (:exp_series(x / 4)^4) \else (:exp_series(x / 16)^16))
\forall x, :exp(x) = \if x = 0 \then 1 \else (\if x < 0 \then (1 / :exp_pos(-x)) \else :exp_pos(x))

# Natural log for x near 1 via series: u = x - 1
\forall u, :ln_series(u) = u - (u^2)/2 + (u^3)/3 - (u^4)/4 + (u^5)/5 - (u^6)/6 + (u^7)/7 - (u^8)/8 + (u^9)/9 - (u^10)/10 + (u^11)/11 - (u^12)/12

\forall x, :ln_pos(x) = 64 * :ln_series(:sqrt(:sqrt(:sqrt(:sqrt(:sqrt(:sqrt(x)))))) - 1)
\forall x, :ln(x) = \if x <= 0 \then (:ln(x)) \else (\if x = 1 \then 0 \else (\if x > 1.2 \or x < 0.8 \then :ln_pos(x) \else :ln_series(x - 1)))

# Base b and Base 2 logarithms defined via change of base
\forall x, b, :log(x, b) = \if b = 10 \then (:ln(x) / 2.302585092994046) \else (:ln(x) / :ln(b))
\forall x, :log2(x) = :ln(x) / 0.6931471805599453

\export :exp, :ln, :log, :log2, :exp_series, :exp_pos, :ln_series, :ln_pos
