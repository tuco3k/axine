# thrown_ball.ax — Projectile motion under standard gravity
\import "lib/abs.ax"

g = 9.8
:v0 = (10.0, 15.0)

# Differential equations of motion
d//d:time :x = 10.0
d//d:time :y = 15.0 - g * :time
d//d:time :vy = -g

# Trajectory height relation in time-space
{\axis :time, :y; :y = 15.0 * :time - 0.5 * g * :time^2}

# State at time = 2.0s
:y_at_2 = 15.0 * 2.0 - 0.5 * g * 2.0^2
:vx_at_2 = 10.0
:vy_at_2 = 15.0 - g * 2.0
:KE = 0.5 * 1.0 * (:vx_at_2^2 + :vy_at_2^2)
