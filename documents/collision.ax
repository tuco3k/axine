# collision.ax — Elastic collision of two bodies
\import "lib/abs.ax"

:m1 = 2.0
:m2 = 1.0
:v1_0 = 3.0
:v2_0 = -1.0

# Conservation of momentum and kinetic energy:
# m1 * v1_0 + m2 * v2_0 = m1 * v1_post + m2 * v2_post
# 1/2 m1 v1_0^2 + 1/2 m2 v2_0^2 = 1/2 m1 v1_post^2 + 1/2 m2 v2_post^2

# Post-collision velocities from 1D elastic collision relations:
# v1_post = ((m1 - m2)*v1_0 + 2*m2*v2_0) / (m1 + m2)
# v2_post = ((m2 - m1)*v2_0 + 2*m1*v1_0) / (m1 + m2)
:v1_post = ((:m1 - :m2) * :v1_0 + 2 * :m2 * :v2_0) / (:m1 + :m2)
:v2_post = ((:m2 - :m1) * :v2_0 + 2 * :m1 * :v1_0) / (:m1 + :m2)

# Initial and final total momentum
:p_initial = :m1 * :v1_0 + :m2 * :v2_0
:total_p = :m1 * :v1_post + :m2 * :v2_post

# Phase space velocity relation
{\axis :v1, :v2; :m1 * :v1 + :m2 * :v2 = :total_p}
