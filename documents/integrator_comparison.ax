# integrator_comparison.ax — Harmonic oscillator energy relations & numerical convergence
\import "lib/abs.ax"
\import "lib/trig.ax"

k = 1.0
m = 1.0
:x0 = 1.0
:v0 = 0.0

# Exact harmonic oscillator equations of motion
d//d:time :x = :vx
d//d:time :vx = -(k / m) * :x

# Exact invariant mechanical energy E(t) = 1/2 m v^2 + 1/2 k x^2 = 0.5
{\axis :time, E; E = 0.5}

# Theoretical local truncation error scaling:
# Euler method (1st order): O(h) error drift
# Verlet method (symplectic 2nd order): O(h^2) bounded oscillation
# RK4 method (4th order): O(h^4) high-order accuracy
h = 0.1
:drift_euler = 0.5 * ((1 + h^2)^50 - 1) * 0.05
:drift_verlet = 0.5 * h^2 * 0.1
:drift_rk4 = 0.5 * (h^4) * (1 / 24)
