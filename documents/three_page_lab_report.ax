## 1. Projectile Motion in 2D Gravity
# Mathematical description of parabolic motion under uniform gravitational field
\import "lib/abs.ax"

g = 9.8
m = 1.0
:v0 = (10.0, 15.0)

# Equations of motion
d//d:time :x = 10.0
d//d:time :y = 15.0 - g * :time
d//d:time :vy = -g

# Trajectory height relation in time-space
{\axis :time, :y; :y = 15.0 * :time - 0.5 * g * :time^2}

# State and Kinetic Energy at t = 2.0s
:y_at_2 = 15.0 * 2.0 - 0.5 * g * 2.0^2
:vx_at_2 = 10.0
:vy_at_2 = 15.0 - g * 2.0
:KE_2 = 0.5 * m * (:vx_at_2^2 + :vy_at_2^2)

## 2. Harmonic Oscillator and Exact Energy Conservation
# Mass-spring conservative dynamical system with unit mass and unit spring constant
k = 1.0
:m_spring = 1.0
:x0 = 1.0

# Exact initial mechanical energy: E0 = 1/2 * k * x0^2
:E0 = 0.5 * k * :x0^2

# System differential relations
d//d:time :x = :vx
d//d:time :vx = -(k / :m_spring) * :x

## 3. Total Energy Invariance
# Constant mechanical energy manifold in time-energy space
{\axis :time, E; E = :E0}

## 4. End-State Precision and Numerical Drift Analysis
# Analytical discretization error scaling for step size h = 0.1 over 10.0s
h = 0.1
:drift_euler = 0.5 * ((1 + h^2)^50 - 1) * 0.05
:drift_verlet = 0.5 * h^2 * 0.1
:drift_rk4 = 0.5 * (h^4) * (1 / 24)
